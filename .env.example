# Server
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL
# Option 1: If using a hosted provider like Neon or Supabase, just set
# DATABASE_URL to the connection string they give you and leave the
# PG_* fields below alone (they'll be ignored).
DATABASE_URL=

# Option 2: For a local Postgres install, leave DATABASE_URL blank above
# and fill in these instead.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=url_shortener

# Redis
REDIS_URL=redis://localhost:6379

# Cache TTL for short-url -> long-url mapping (seconds)
CACHE_TTL_SECONDS=86400

# Length of generated short codes
SHORT_CODE_LENGTH=7
